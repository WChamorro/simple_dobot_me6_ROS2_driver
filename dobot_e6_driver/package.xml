<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>dobot_e6_driver</name>
  <version>0.1.0</version>

  <description>
    ROS 2 driver for the Dobot Magician E6 robot using the Dobot TCP/IP Python SDK.
    Provides robot state feedback, joint position control, joint velocity control,
    predefined poses, motion monitoring, stop commands, and recovery functions.
  </description>

  <maintainer email="william.chamorro@epn.edu.ec">
    William Chamorro
  </maintainer>

  <license>Apache-2.0</license>


  <!-- ====================================================== -->
  <!-- Build system                                           -->
  <!-- ====================================================== -->

  <buildtool_depend>ament_python</buildtool_depend>


  <!-- ====================================================== -->
  <!-- ROS 2 runtime dependencies                             -->
  <!-- ====================================================== -->

  <!-- ROS 2 Python client library -->
  <exec_depend>rclpy</exec_depend>

  <!-- Standard messages:
       Bool, Empty, Int32, String -->
  <exec_depend>std_msgs</exec_depend>

  <!-- JointState feedback -->
  <exec_depend>sensor_msgs</exec_depend>

  <!-- Custom Dobot messages:
       JointPositionCommand
       JointVelocityCommand -->
  <exec_depend>dobot_e6_msgs</exec_depend>


  <!-- ====================================================== -->
  <!-- Launch system                                          -->
  <!-- ====================================================== -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Used by the launch file to locate the package share
       directory and configuration YAML -->
  <exec_depend>ament_index_python</exec_depend>


  <!-- ====================================================== -->
  <!-- Tests                                                  -->
  <!-- ====================================================== -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>


  <!-- ====================================================== -->
  <!-- Package export                                         -->
  <!-- ====================================================== -->

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
