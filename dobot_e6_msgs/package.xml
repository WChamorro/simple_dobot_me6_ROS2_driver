<?xml version="1.0"?>

<package format="3">

  <name>dobot_e6_msgs</name>

  <version>0.0.1</version>

  <description>
    Custom ROS 2 messages for the Dobot Magician E6 driver.
  </description>


  <maintainer email="william@todo.todo">
    William
  </maintainer>


  <license>Apache-2.0</license>


  <!-- ===================================================== -->
  <!-- Build system                                          -->
  <!-- ===================================================== -->

  <buildtool_depend>
    ament_cmake
  </buildtool_depend>


  <!-- ===================================================== -->
  <!-- ROS interface generation                              -->
  <!-- ===================================================== -->

  <build_depend>
    rosidl_default_generators
  </build_depend>


  <!-- ===================================================== -->
  <!-- Runtime interface support                             -->
  <!-- ===================================================== -->

  <exec_depend>
    rosidl_default_runtime
  </exec_depend>


  <!-- ===================================================== -->
  <!-- ROS interface package declaration                     -->
  <!-- ===================================================== -->

  <member_of_group>
    rosidl_interface_packages
  </member_of_group>


  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>
